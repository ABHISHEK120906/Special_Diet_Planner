# Database Connection (Neon PostgreSQL, Supabase, or local PostgreSQL)
DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Flask Configuration
FLASK_SECRET_KEY=your-random-secret-key-here

# Optional: Google Gemini AI API Key (Clinical fallback recipes are used if not provided)
GEMINI_API_KEY=your-gemini-api-key-here
